# ─────────────────────────────────────────────
# Forum Framework — exemplo de configuração
# Copie para .env e ajuste os valores
# ─────────────────────────────────────────────

# App
APP_NAME=Forum
APP_ENV=development
APP_URL=http://localhost:3000
API_PORT=8080
API_URL=http://localhost:8080

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Banco de dados — driver: postgres | mariadb
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=forum
DB_PASSWORD=forum
DB_NAME=forum
DB_SSLMODE=disable

# Redis (opcional — vazio = desabilitado)
REDIS_URL=

# Storage — provider: local | minio
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_URL=http://localhost:8080/files

# MinIO / S3 (quando STORAGE_PROVIDER=minio)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=forum
MINIO_USE_SSL=false

# CORS (origens separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000
